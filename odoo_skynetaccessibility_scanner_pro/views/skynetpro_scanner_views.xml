<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!--  Form View                                                        -->
    <!-- ============================================================== -->
    <record id="view_skynetpro_scanner_form" model="ir.ui.view">
        <field name="name">skynet.accessibility.scanner.form</field>
        <field name="model">x_odoo_skynetaccessibility_scanner_pro</field>
        <field name="arch" type="xml">
            <form string="SkynetAccessibility Scanner" class="o_skynetpro_form">
            <link rel="stylesheet" href="/odoo_skynetaccessibility_scanner_pro/static/src/css/skynetpro_scanner.css"/>
            <script src="/odoo_skynetaccessibility_scanner_pro/static/src/js/skynetpro_scanner.js"></script>
            <sheet>
                    <div class="scanning-monitoring-app" id="skynetproAppRoot">

                        <!-- ══════════════════════════════════════════ -->
                        <!--  LOADING OVERLAY                           -->
                        <!-- ══════════════════════════════════════════ -->
                        <div id="skynetproLoading" class="skynetpro-loading-overlay">
                            <img src="/odoo_skynetaccessibility_scanner_pro/static/src/img/assets/loader.gif"
                                 alt="Loading..." style="width:64px;height:64px;"/>
                            <p style="margin-top:12px;color:#420083;font-weight:500;">
                                Loading accessibility data...
                            </p>
                        </div>

                        <!-- ══════════════════════════════════════════ -->
                        <!--  ERROR BANNER                              -->
                        <!-- ══════════════════════════════════════════ -->
                        <div id="skynetproErrorBanner" class="skynetpro-error-banner" style="display:none;">
                            <span>Warning: </span>
                            <span id="skynetproErrorMsg"></span>
                        </div>

                        <!-- ══════════════════════════════════════════ -->
                        <!--  EMAIL REMINDER BANNER + POPUP             -->
                        <!--  Shown only when the registered domain has -->
                        <!--  no valid email (empty / no-reply@domain)  -->
                        <!-- ══════════════════════════════════════════ -->
                        <div id="skynetproEmailBanner" class="skynetpro-email-banner" style="display:none;">
                            <span class="skynetpro-email-banner-text">
                                Please enter your email for further scanning reports.
                            </span>
                            <button type="button" class="skynetpro-email-toggle-btn"
                                    onclick="window._skynetproOpenEmailPopup(event)">Add Email</button>
                        </div>

                        <div id="skynetproEmailModal" class="skynetpro-modal-overlay" style="display:none;"
                             role="dialog" aria-modal="true" aria-labelledby="skynetproEmailModalTitle"
                             onclick="if(event.target===this){window._skynetproCloseEmailPopup(event,true);}">
                            <div class="skynetpro-modal-box">
                                <button type="button" class="skynetpro-modal-close" aria-label="Close"
                                        onclick="window._skynetproCloseEmailPopup(event,true)">&#215;</button>
                                <h3 id="skynetproEmailModalTitle" class="skynetpro-email-form-title">Register Your Details</h3>
                                <p class="skynetpro-modal-sub">
                                    No valid email is registered for this domain. Please enter your
                                    email to receive further scanning reports.
                                </p>
                                <div id="skynetproEmailFormError" class="skynetpro-email-form-error" style="display:none;"></div>
                                <div id="skynetproEmailFormSuccess" class="skynetpro-email-form-success" style="display:none;"></div>
                                <div class="skynetpro-email-form-row">
                                    <span class="skynetpro-email-form-label">Full Name <span style="color:#e53e3e;">*</span></span>
                                    <input id="skynetproRegName" class="skynetpro-email-form-input" type="text"
                                           placeholder="Enter your full name" aria-label="Full Name" autocomplete="name"/>
                                </div>
                                <div class="skynetpro-email-form-row">
                                    <span class="skynetpro-email-form-label">Email Address <span style="color:#e53e3e;">*</span></span>
                                    <input id="skynetproRegEmail" class="skynetpro-email-form-input" type="email"
                                           placeholder="Enter your email address" aria-label="Email Address" autocomplete="email"/>
                                </div>
                                <div class="skynetpro-email-form-actions">
                                    <button id="skynetproRegSaveBtn" class="skynetpro-email-save-btn" type="button"
                                            onclick="window._skynetproSaveEmail(event)">
                                        <span id="skynetproRegSaveBtnText">Save</span>
                                        <svg id="skynetproRegSaveSpinner" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                             viewBox="0 0 24 24" fill="none"
                                             style="display:none;margin-left:8px;animation:skynetpro-spin 0.8s linear infinite;">
                                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"
                                                    stroke-dasharray="31.4" stroke-dashoffset="10"/>
                                        </svg>
                                    </button>
                                    <button class="skynetpro-email-cancel-btn" type="button"
                                            onclick="window._skynetproCloseEmailPopup(event,true)">Later</button>
                                </div>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════ -->
                        <!--  SECTION 1 — MAIN DASHBOARD               -->
                        <!-- ══════════════════════════════════════════ -->
                        <div id="skynetproSection1" class="scans" style="display:none;">

                            <h2 class="title">My Scans</h2>

                            <!-- Status Row -->
                            <section class="status">
                                <div class="page-background"></div>

                                <!--
                                    SCAN SCORE CARD
                                    Condition logic (mirrors PHP ManagerController exactly):
                                      if is_expired == 1 OR end_date < today
                                          show "N/A"  (red #9F0000)
                                      elif scan_violation_total == 0
                                          show "N/A"  (grey status-inactive)
                                      else
                                          show "{success_percentage}%"  (red, bold)
                                          + progress bar at {success_percentage}% width
                                          + "Violations: {total_fail_sum}"  (red)
                                          + card is clickable to open Section 2
                                -->
                                <div class="status-card" id="skynetproScanScoreCard" style="cursor:pointer;">
                                    <span class="status-title">Scan Score</span>
                                    <div class="status-value" id="skynetproScanScoreValue">
                                        <!-- Populated by JS -->
                                    </div>
                                </div>

                                <!--
                                    LAST SCANNED CARD
                                    Condition logic (mirrors PHP ManagerController exactly):
                                      if url_scan_status &lt; 2        → "Not Started"
                                      elif scan_status == 0            → "Not Started"
                                      elif scan_status in [1,2]        → "Scanning X/Y"
                                      elif scan_status == 3            → "X Pages + date"
                                -->
                                <div class="status-card">
                                    <span class="status-title">Last Scanned</span>
                                    <div class="status-value" id="skynetproLastScannedValue">
                                        <!-- Populated by JS -->
                                    </div>
                                </div>

                            </section>

                            <hr class="divider"/>

                            <!--
                                STATE: FREE / TRIAL PLAN
                                Condition: is_trial_period == 1 AND not expired AND not cancelled
                                  skynetproFreePlanName   → "Free Plan"
                                  skynetproFreePlanPages  → "Scan up to {pageViews} Pages"
                                  skynetproFreePlanBadge  → "Current Plan"  (green #D1FFD3)
                                  skynetproFreeExpiry     → "Expires on: {end_date}"  (red)
                                  skynetproFreeActivateBtn → "Activate Now"  (purple #420083)
                            -->
                            <section id="skynetproPlanFree" class="plan" style="display:none;">
                                <div class="page-background"></div>
                                <div class="plan-info">
                                    <div class="plans-left">
                                        <div class="plan-type free">
                                            <div class="icon-circle">
                                                <img src="/odoo_skynetaccessibility_scanner_pro/static/src/img/assets/round.svg" alt="Round" height="20" width="20"/>
                                            </div>
                                            <span id="skynetproFreePlanName">Free Plan</span>
                                        </div>
                                        <div class="plan-desc">
                                            <ul><li id="skynetproFreePlanPages">Scan up to 10 Pages</li></ul>
                                        </div>
                                        <span class="plan-badge" id="skynetproFreePlanBadge">Current Plan</span>
                                    </div>
                                    <div class="plans-right">
                                        <span class="plan-renewal" id="skynetproFreeExpiry">
                                            Expires on: <strong>—</strong>
                                        </span>
                                        <button type="button" class="cancel-btn" id="skynetproFreeActivateBtn" onclick="window._skynetproBtnClick('free-activate', event)">
                                            Activate Now
                                        </button>
                                    </div>
                                </div>
                            </section>

                            <!--
                                STATE: ACTIVE / PURCHASED PLAN
                                Condition: has activePackageId AND not trial AND not expired AND not cancelled
                                  skynetproActivePlanName  → "{package_name} Plan"
                                  skynetproActivePlanPages → "Scan up to {pageViews} Pages"
                                  skynetproActivePlanBadge → "Current Plan"  (green #D1FFD3)
                                  skynetproActiveRenewal   → "Renews on: {end_date}"
                                  skynetproCancelSubBtn    → "Cancel Subscription"
                            -->
                            <section id="skynetproPlanActive" class="plan" style="display:none;">
                                <div class="page-background"></div>
                                <div class="plan-info">
                                    <div class="plans-left">
                                        <div class="plan-type">
                                            <div class="icon-circle">
                                                <img src="/odoo_skynetaccessibility_scanner_pro/static/src/img/assets/round.svg" alt="Round" height="20" width="20"/>
                                            </div>
                                            <span id="skynetproActivePlanName"></span>
                                        </div>
                                        <div class="plan-desc">
                                            <ul><li id="skynetproActivePlanPages"></li></ul>
                                        </div>
                                        <span class="plan-badge" id="skynetproActivePlanBadge">Current Plan</span>
                                    </div>
                                    <div class="plans-right">
                                        <span class="plan-renewal" id="skynetproActiveRenewal">
                                            Renews on: <strong>—</strong>
                                        </span>
                                        <button type="button" class="cancel-btn" id="skynetproCancelSubBtn" onclick="window._skynetproBtnClick('cancel-sub', event)">
                                            Cancel Subscription
                                        </button>
                                    </div>
                                </div>
                            </section>

                            <!--
                                STATE: EXPIRED PLAN
                                Condition: is_expired == 1 OR end_date &lt; today
                                  skynetproExpiredTitle       → "Your Plan has Expired"  (red #9F0000 bold)
                                  skynetproExpiredDate        → ID is on the <span> wrapper (FIX 3).
                                                             JS injects full "Expired on: <strong>date</strong>"
                                                             so the label is never hardcoded + duplicated.
                                  skynetproExpiredActivateBtn → "Renew Plan"  (purple #420083)
                                  Scan Score also shows N/A red in this state.
                            -->
                            <section id="skynetproPlanExpired" class="plan" style="display:none;">
                                <div class="page-background"></div>
                                <div class="plan-info">
                                    <div class="plans-left">
                                        <div class="plan-type skynetpro-expired-title">
                                            <div class="icon-circle">
                                                <img src="/odoo_skynetaccessibility_scanner_pro/static/src/img/assets/round.svg" alt="Round" height="20" width="20"/>
                                            </div>
                                            <span id="skynetproExpiredTitle">Your Plan has Expired</span>
                                        </div>
                                    </div>
                                    <div class="plans-right">
                                        <!--
                                            FIX 3: id="skynetproExpiredDate" moved from the inner <strong>
                                            to this <span> wrapper.  JS sets innerHTML on the <span>,
                                            injecting "Expired on: <strong>date</strong>" in full.
                                            Previously the id was on <strong>, so JS wrote
                                            "Expired on: <strong>date</strong>" inside it, producing
                                            nested <strong> tags and a doubled "Expired on:" label.
                                        -->
                                        <span class="plan-renewal" id="skynetproExpiredDate">
                                            <!-- Populated by JS: "Expired on: <strong>date</strong>" -->
                                        </span>
                                        <button type="button" class="cancel-btn" style="background-color:#420083;color:#fff;" id="skynetproExpiredActivateBtn" onclick="window._skynetproBtnClick('expired-renew', event)">
                                            Renew Plan
                                        </button>
                                    </div>
                                </div>
                            </section>

                            <!--
                                STATE: CANCELLED PLAN
                                Condition: cancel_date &lt;= today AND not expired
                                  skynetproCancelledPlanName  → "{package_name} Plan"
                                  skynetproCancelledPlanPages → "Scan up to {pageViews} Pages"
                                  skynetproCancelledPlanBadge → "Cancelled Plan"  (red #ffd1d1)
                                  skynetproCancelledExpiry    → "Expires on: {end_date}"  (red)
                                  skynetproRenewPlanBtn       → "Renew Plan"  (purple #420083)
                            -->
                            <section id="skynetproPlanCancelled" class="plan" style="display:none;">
                                <div class="page-background"></div>
                                <div class="plan-info">
                                    <div class="plans-left">
                                        <div class="plan-type">
                                            <div class="icon-circle">
                                                <img src="/odoo_skynetaccessibility_scanner_pro/static/src/img/assets/round.svg" alt="Round" height="20" width="20"/>
                                            </div>
                                            <span id="skynetproCancelledPlanName"></span>
                                        </div>
                                        <div class="plan-desc">
                                            <ul><li id="skynetproCancelledPlanPages"></li></ul>
                                        </div>
                                        <span class="plan-badge skynetpro-badge-cancelled" id="skynetproCancelledPlanBadge">Cancelled Plan</span>
                                    </div>
                                    <div class="plans-right">
                                        <span class="plan-renewal" id="skynetproCancelledExpiry">
                                            Expires on: <strong>—</strong>
                                        </span>
                                        <button type="button" class="cancel-btn" style="background-color:#420083;color:#fff;" id="skynetproRenewPlanBtn" onclick="window._skynetproBtnClick('cancelled-renew', event)">
                                            Renew Plan
                                        </button>
                                    </div>
                                </div>
                            </section>

                            <!-- Pricing Section -->
                            <section class="pricing">
                                <div class="page-background"></div>

                                <!--
                                    FIX 9: Raw <input type="checkbox"> removed from arch XML.
                                    Odoo's renderer can strip or interfere with raw <input> elements
                                    inside a <form> sheet view depending on the Odoo version.
                                    The hidden <input id="billing-toggle"> is now injected at runtime
                                    by JS into the #skynetproBillingToggleWrapper div below.
                                    The visible slider element (skynetproBillingSlider) and labels
                                    are plain divs/spans, fully safe in Odoo arch.
                                    JS attaches click handlers to labels and the slider div directly.
                                -->
                                <div class="billing-toggle">
                                    <span class="label active" id="monthly-label">Pay Monthly</span>
                                    <div class="switch">
                                        <!-- JS injects: <input type="checkbox" id="billing-toggle"/> -->
                                        <div id="skynetproBillingToggleWrapper"></div>
                                        <span class="slider" id="skynetproBillingSlider"></span>
                                    </div>
                                    <span class="label" id="annual-label">Pay Annually</span>
                                    <span class="save">Save 20%</span>
                                </div>

                                <div id="skynetproMonthlyTiers" class="pricing-tiers">
                                </div>

                                <div id="skynetproAnnualTiers" class="pricing-tiers" style="display:none;">
                                </div>

                                <p class="pricing-contact">
                                    Are you looking for a custom plan or Enterprise plan? Contact us
                                    <a href="mailto:hello@skynettechnologies.com">hello@skynettechnologies.com</a>
                                </p>
                            </section>

                            <!-- Help Section -->
                            <section class="help">
                                <p class="help-text">
                                    <strong>Facing any issues with SkynetAccessibility Scanner?</strong>
                                    Report a problem, we will get back to you very soon!
                                </p>
                                <a href="https://www.skynettechnologies.com/report-accessibility-problem"
                                   target="_blank" class="help-btn" role="button">
                                    Report a problem
                                </a>
                            </section>

                        </div><!-- end Section 1 -->

                        <!-- ══════════════════════════════════════════ -->
                        <!--  SECTION 2 — WCAG VIOLATION REPORT        -->
                        <!-- ══════════════════════════════════════════ -->
                        <div id="skynetproSection2" class="accessibility-report" style="display:none;">

                            <div class="report-date">
                                <span style="font-weight:500;">Report Date:</span>
                                <span id="skynetproS2ReportDate" style="border:1px solid #ccc;padding:8px 14px;border-radius:6px;font-weight:500;">—</span>
                            </div><br/>

                            <section class="top-section">

                                <div class="card score-card">
                                    <h3>Accessibility Score</h3>
                                    <div class="accessibility-score">
                                        <div class="score-value" id="skynetproS2ScoreValue">0%</div>
                                        <span class="status-text not-compliant" id="skynetproS2StatusText">Not Compliant</span>
                                    </div>
                                    <div class="progress-bar">
                                        <div class="progress-fill" id="skynetproS2ScoreBar" style="width:0%;"></div>
                                    </div>
                                    <p class="note">
                                        Automated Accessibility score has limitations.
                                        We recommend Manual Accessibility Audit.
                                    </p>
                                </div>

                                <div class="card pages-card">
                                    <h3>Web Pages Scanned</h3>
                                    <div class="pages-value" id="skynetproS2PagesValue">0</div>
                                    <div class="progress-bar">
                                        <div class="progress-fill" id="skynetproS2PagesBar" style="width:0%;"></div>
                                    </div>
                                    <p class="note" id="skynetproS2PagesNote">0 pages scanned out of 0</p>
                                </div>

                            </section><br/><br/>

                            <section class="wcag-section">
                                <div class="wcag-header">
                                    <h3>WCAG 2.1/2.2</h3>
                                    <button type="button" id="skynetproS2ViewViolationsBtn" class="view-btn" onclick="window._skynetproBtnClick('view-violations', event)">
                                        View all Violations
                                        <svg xmlns="http://www.w3.org/2000/svg" width="6" height="10" viewBox="0 0 6 10" fill="none">
                                            <path d="M6 5.00002C6 5.17924 5.92797 5.35843 5.78422 5.49507L1.25832 9.79486C0.970413 10.0684 0.503627 10.0684 0.21584 9.79486C-0.0719468 9.52145 -0.0719468 9.07807 0.21584 8.80452L4.22061 5.00002L0.21598 1.19549C-0.0718073 0.921968 -0.0718073 0.478632 0.21598 0.205242C0.503767 -0.0684128 0.970553 -0.0684128 1.25846 0.205242L5.78436 4.50496C5.92814 4.64166 6 4.82086 6 5.00002Z" fill="white"/>
                                        </svg>
                                    </button>
                                </div>

                                <div class="checks-grid">
                                    <div class="check-card failed">
                                        <span class="check-value" id="skynetproS2FailedChecks">0</span>
                                        <span class="check-label">Failed Checks</span>
                                    </div>
                                    <div class="check-card passed">
                                        <span class="check-value" id="skynetproS2PassedChecks">0</span>
                                        <span class="check-label">Passed Checks</span>
                                    </div>
                                    <div class="check-card na">
                                        <span class="check-value" id="skynetproS2NAChecks">0</span>
                                        <span class="check-label">N/A Checks</span>
                                    </div>
                                </div>

                                <hr class="divider"/>

                                <div class="violations-grid">
                                    <div class="violation-card">
                                        <span class="violation-title">Level A</span>
                                        <span class="violation-count">
                                            <span id="skynetproS2LevelA">0</span> violations
                                        </span>
                                    </div>
                                    <div class="violation-card">
                                        <span class="violation-title">Level AA</span>
                                        <span class="violation-count">
                                            <span id="skynetproS2LevelAA">0</span> violations
                                        </span>
                                    </div>
                                    <div class="violation-card">
                                        <span class="violation-title">Level AAA</span>
                                        <span class="violation-count">
                                            <span id="skynetproS2LevelAAA">0</span> violations
                                        </span>
                                    </div>
                                </div>

                            </section><br/><br/>

                            <button type="button" class="back-btn" id="skynetproBackBtn" onclick="window._skynetproBtnClick('back', event)">Back</button>

                        </div><!-- end Section 2 -->

                    </div><!-- end scanning-monitoring-app -->
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_open_skynetpro_scanner" model="ir.actions.act_window">
        <field name="name">My Scans</field>
        <field name="res_model">x_odoo_skynetaccessibility_scanner_pro</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>